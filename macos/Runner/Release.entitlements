<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release build: no debugger attach. Adhoc/Developer ID signing
	     leaks a default of true unless we explicitly set this to false. -->
	<key>com.apple.security.get-task-allow</key>
	<false/>

	<!-- The IPTV player must access the network (Xtream/M3U/TMDB). -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- The media_kit (libmpv), sqlite, and json packages may contain unsigned dylibs;
	     unless library validation is disabled, they are blocked during launch. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- So the Dart VM and some codecs can generate code at runtime. This may
	     look unnecessary in an AOT release, but the ffmpeg/mpv inside media_kit
	     requires JIT memory in some scenarios. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
